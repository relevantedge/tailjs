{
  "name": "@tailjs/react",
  "version": "0.42.0-preview2",
  "description": "tail.js preact/react integration.",
  "homepage": "https://github.com/relevantedge/tailjs",
  "license": "LGPL3",
  "author": "RelevantEdge (https://www.relevant-edge.com)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.cjs"
      }
    },
    "./webpack": {
      "types": "./webpack/index.d.ts",
      "default": "./webpack/index.cjs"
    },
    "./jsx": "./jsx/index.js",
    "./jsx/jsx-runtime": "./jsx/jsx-runtime.js",
    "./jsx/jsx-dev-runtime": "./jsx/jsx-dev-runtime.js",
    "./jsx/react-dom": "./jsx/react-dom.js"
  },
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "dependencies": {
    "enhanced-resolve": "^5.18.1",
    "resolve-from": "^5.0.0"
  },
  "peerDependencies": {
    "@types/react": ">=18.3.0",
    "@types/react-dom": ">=18.3.0",
    "react": ">=18.3.1",
    "react-dom": ">=18.3.1",
    "webpack": "^5.15.0"
  },
  "peerDependenciesMeta": {
    "@types/react": {
      "optional": true
    },
    "@types/react-dom": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "react-dom": {
      "optional": true
    },
    "webpack": {
      "optional": true
    }
  }
}