{
  "name": "@tailjs/next",
  "version": "0.42.0-preview3",
  "description": "tail.js NextJS integration.",
  "homepage": "https://github.com/relevantedge/tailjs",
  "license": "LGPL3",
  "author": "RelevantEdge (https://www.relevant-edge.com)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./server/index.d.ts",
        "default": "./server/index.mjs"
      },
      "require": {
        "types": "./server/index.d.ts",
        "default": "./server/index.cjs"
      }
    }
  },
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "bin": {
    "tailjs-init-next": "./cli/tailjs-init-next.cjs"
  },
  "dependencies": {
    "@tailjs/client": "https://gitpkg.vercel.app/relevantedge/tailjs/client?latest/0.42",
    "@tailjs/engine": "https://gitpkg.vercel.app/relevantedge/tailjs/engine?latest/0.42",
    "@tailjs/node": "https://gitpkg.vercel.app/relevantedge/tailjs/node?latest/0.42",
    "@tailjs/react": "https://gitpkg.vercel.app/relevantedge/tailjs/react?latest/0.42"
  },
  "peerDependencies": {
    "next": ">=14.2.0",
    "react": ">=18.3.1"
  }
}