{
  "name": "@tailjs/next",
  "version": "0.42.0-preview2",
  "description": "tail.js NextJS integration.",
  "homepage": "https://github.com/relevantedge/tailjs",
  "license": "LGPL3",
  "author": "RelevantEdge (https://www.relevant-edge.com)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.cjs"
      }
    },
    "./server": {
      "import": {
        "types": "./server/index.d.ts",
        "default": "./server/index.mjs"
      },
      "require": {
        "types": "./server/index.d.ts",
        "default": "./server/index.cjs"
      }
    }
  },
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "bin": {
    "tailjs-init-next": "./cli/tailjs-init-next.cjs"
  },
  "dependencies": {
    "@tailjs/client": "github:relevantedge/tailjs#dist/0.42/client",
    "@tailjs/engine": "github:relevantedge/tailjs#dist/0.42/engine",
    "@tailjs/node": "github:relevantedge/tailjs#dist/0.42/node",
    "@tailjs/react": "github:relevantedge/tailjs#dist/0.42/react"
  },
  "peerDependencies": {
    "next": ">=14.2.0",
    "react": ">=18.3.1"
  }
}