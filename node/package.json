{
  "name": "@tailjs/node",
  "version": "0.42.0-preview3",
  "description": "A node.js native engine host for tail.js.",
  "homepage": "https://github.com/relevantedge/tailjs",
  "license": "LGPL3",
  "author": "RelevantEdge (https://www.relevant-edge.com)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.cjs"
      }
    }
  },
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "bin": {
    "tailjs": "./cli/tailjs.cjs"
  },
  "dependencies": {
    "@tailjs/client": "https://gitpkg.vercel.app/relevantedge/tailjs/client?latest/0.42.3",
    "@tailjs/engine": "https://gitpkg.vercel.app/relevantedge/tailjs/engine?latest/0.42.3",
    "@tailjs/transport": "https://gitpkg.vercel.app/relevantedge/tailjs/transport?latest/0.42.3",
    "@tailjs/types": "https://gitpkg.vercel.app/relevantedge/tailjs/types?latest/0.42.3",
    "@tailjs/util": "https://gitpkg.vercel.app/relevantedge/tailjs/util?latest/0.42.3",
    "on-headers": "^1.0.2",
    "request-ip": "^3.3.0",
    "tar": "^7.4.3",
    "tar-stream": "^3.1.7",
    "uuid": "^9.0.1",
    "winston": "^3.17.0",
    "winston-daily-rotate-file": "^5.0.0",
    "yauzl": "^3.2.0"
  }
}