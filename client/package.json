{
  "name": "@tailjs/client",
  "version": "0.42.0-preview2",
  "description": "tail.js client library",
  "homepage": "https://github.com/relevantedge/tailjs",
  "license": "LGPL3",
  "author": "RelevantEdge (https://www.relevant-edge.com)",
  "type": "module",
  "exports": {
    ".": {
      "import": {
        "types": "./index.d.ts",
        "default": "./index.mjs"
      },
      "require": {
        "types": "./index.d.ts",
        "default": "./index.cjs"
      }
    },
    "./external": {
      "import": {
        "types": "./external/index.d.ts",
        "default": "./external/index.mjs"
      },
      "require": {
        "types": "./external/index.d.ts",
        "default": "./external/index.cjs"
      }
    },
    "./script": {
      "import": {
        "types": "./script/index.d.ts",
        "default": "./script/index.mjs"
      },
      "require": {
        "types": "./script/index.d.ts",
        "default": "./script/index.cjs"
      }
    },
    "./version": {
      "import": {
        "types": "./version/index.d.ts",
        "default": "./version/index.mjs"
      },
      "require": {
        "types": "./version/index.d.ts",
        "default": "./version/index.cjs"
      }
    }
  },
  "main": "./index.cjs",
  "module": "./index.mjs",
  "types": "./index.d.ts",
  "dependencies": {
    "@ygoe/msgpack": "github:nielskuhnel/msgpack.js#feature/big-float-fix"
  }
}